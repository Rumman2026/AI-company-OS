---
import AdminLayout from '../../layouts/AdminLayout.astro';
import NotesSection from '../../components/NotesSection.astro';
import { getCurrentMembership } from '../../lib/auth/membership';
import {
  createSupabaseContactRepository,
  createSupabaseLeadRepository,
  createSupabaseAuditLogRepository,
  createSupabaseCompanyRepository,
  createSupabaseNoteRepository,
} from '@ai-company-os/db';
import { leadStatusTone } from '@ai-company-os/ui-kit';
import type { LeadStatus, CompanyId, Note } from '@ai-company-os/core-models';

const user = Astro.locals.user!;
const membership = await getCurrentMembership(Astro.locals.supabase, user.id);
const { id } = Astro.params;
const linkError = Astro.url.searchParams.get('error');

let contact: {
  id: string;
  displayName: string;
  phone?: string;
  email?: string;
  companyId?: CompanyId;
} | null = null;
let leads: Array<{ id: string; status: LeadStatus; createdAt: string }> = [];
let companyName: string | null = null;
let allCompanies: Array<{ id: string; name: string }> = [];
let notes: Note[] = [];
let notFound = false;

if (membership && id) {
  const contactRepo = createSupabaseContactRepository(Astro.locals.supabase);
  const result = await contactRepo.getContact(membership.businessId, id);

  if (result.ok) {
    contact = result.contact;
    const auditLog = createSupabaseAuditLogRepository(Astro.locals.supabase);
    const leadRepo = createSupabaseLeadRepository(Astro.locals.supabase, auditLog);
    const leadsResult = await leadRepo.listLeads(membership.businessId, { contactId: id });
    if (leadsResult.ok) {
      leads = leadsResult.leads.map((l) => ({ id: l.id, status: l.status, createdAt: l.createdAt }));
    }

    const companyRepo = createSupabaseCompanyRepository(Astro.locals.supabase);
    const companiesResult = await companyRepo.listCompanies(membership.businessId);
    if (companiesResult.ok) {
      allCompanies = companiesResult.companies;
      if (contact.companyId) {
        companyName = allCompanies.find((c) => c.id === contact!.companyId)?.name ?? null;
      }
    }

    const noteRepo = createSupabaseNoteRepository(Astro.locals.supabase);
    const notesResult = await noteRepo.listNotes(membership.businessId, {
      entityType: 'contact',
      entityId: id,
    });
    if (notesResult.ok) notes = notesResult.notes;
  } else {
    notFound = true;
  }
}
---

<AdminLayout title="Contact detail" membership={membership}>
  <p><a href="/contacts">&larr; Back to contacts</a></p>
  {
    notFound ? (
      <div class="uikit-error-banner" role="alert">
        Contact not found.
      </div>
    ) : contact ? (
      <>
        <h1>{contact.displayName}</h1>
        <dl>
          <dt>Phone</dt>
          <dd>{contact.phone ?? '—'}</dd>
          <dt>Email</dt>
          <dd>{contact.email ?? '—'}</dd>
          <dt>Company</dt>
          <dd>
            {companyName ? <a href={`/companies/${contact.companyId}`}>{companyName}</a> : '—'}
          </dd>
        </dl>

        {linkError ? (
          <div class="uikit-error-banner" role="alert">
            Could not link company: {linkError}
          </div>
        ) : null}

        {allCompanies.length > 0 ? (
          <form method="POST" action={`/api/contacts/${contact.id}/link-company`} style="max-width: 320px;">
            <div class="uikit-form-field">
              <label for="companyId">Link to company</label>
              <select id="companyId" name="companyId">
                {allCompanies.map((c) => (
                  <option value={c.id} selected={c.id === contact!.companyId}>
                    {c.name}
                  </option>
                ))}
              </select>
            </div>
            <button type="submit" class="uikit-button uikit-button--secondary">
              Update company
            </button>
          </form>
        ) : (
          <p style="color: var(--color-text-muted); font-size: 0.875rem;">
            No companies exist yet - <a href="/companies">add one</a> to link this contact.
          </p>
        )}

        <h2>Leads</h2>
        {leads.length === 0 ? (
          <div class="uikit-empty-state">
            <p class="uikit-empty-state__title">No leads for this contact</p>
          </div>
        ) : (
          <div class="uikit-table-scroll">
            <table class="uikit-table">
              <thead>
                <tr>
                  <th>Status</th>
                  <th>Created</th>
                  <th />
                </tr>
              </thead>
              <tbody>
                {leads.map((lead) => (
                  <tr>
                    <td>
                      <span class={`uikit-badge uikit-badge--${leadStatusTone(lead.status)}`}>
                        {lead.status}
                      </span>
                    </td>
                    <td>{new Date(lead.createdAt).toLocaleString()}</td>
                    <td>
                      <a href={`/leads/${lead.id}`}>View</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <NotesSection
          entityType="contact"
          entityId={contact.id}
          notes={notes}
          redirectTo={`/contacts/${contact.id}`}
        />
      </>
    ) : (
      <div class="uikit-error-banner" role="alert">
        Your account has no business membership yet.
      </div>
    )
  }
</AdminLayout>
