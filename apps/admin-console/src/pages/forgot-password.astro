---
import AuthLayout from '../layouts/AuthLayout.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
---

<AuthLayout title="Forgot password">
  <h1>Reset your password</h1>
  {
    sent ? (
      <p>
        If that email has an admin account, a password reset link has been sent. Check your inbox.
      </p>
    ) : (
      <form method="POST" action="/api/auth/forgot-password">
        <div class="uikit-form-field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <button type="submit" class="uikit-button uikit-button--primary" style="width: 100%;">
          Send reset link
        </button>
      </form>
    )
  }
  <p style="margin-top: 1rem; font-size: 0.875rem;">
    <a href="/login">Back to log in</a>
  </p>
</AuthLayout>
