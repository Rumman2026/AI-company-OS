---
import AuthLayout from '../layouts/AuthLayout.astro';
import { getAuthenticatedUser } from '../lib/auth/session';

const user = await getAuthenticatedUser(Astro.locals.supabase);
const error = Astro.url.searchParams.get('error');
const ERROR_MESSAGES: Record<string, string> = {
  'password-too-short': 'Password must be at least 8 characters.',
  'update-failed': 'Could not update your password. Try requesting a new reset link.',
};
const errorMessage = error ? (ERROR_MESSAGES[error] ?? 'Something went wrong.') : null;
---

<AuthLayout title="Set a new password">
  <h1>Set a new password</h1>
  {
    !user ? (
      <p>
        This reset link is invalid or has expired. <a href="/forgot-password">Request a new one</a>.
      </p>
    ) : (
      <>
        {errorMessage ? <div class="uikit-error-banner" role="alert">{errorMessage}</div> : null}
        <form method="POST" action="/api/auth/reset-password">
          <div class="uikit-form-field">
            <label for="password">New password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
            />
          </div>
          <button type="submit" class="uikit-button uikit-button--primary" style="width: 100%;">
            Update password
          </button>
        </form>
      </>
    )
  }
</AuthLayout>
