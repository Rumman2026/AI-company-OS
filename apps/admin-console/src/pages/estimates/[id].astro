---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCurrentMembership } from '../../lib/auth/membership';
import {
  createSupabaseEstimateRepository,
  createSupabaseEstimateLineItemRepository,
  createSupabaseServicePackageRepository,
  createSupabaseEstimateAttachmentRepository,
  type EstimateAttachmentWithSignedUrl,
} from '@ai-company-os/db';
import { formatMinorUnitsAsDollars } from '../../lib/estimates/parse-amount';
import { estimateStatusTone } from '@ai-company-os/ui-kit';
import {
  calculateEstimateTotals,
  createCurrencyCode,
  createMoney,
  type Estimate,
  type EstimateLineItem,
  type ServicePackage,
} from '@ai-company-os/core-models';

const user = Astro.locals.user!;
const membership = await getCurrentMembership(Astro.locals.supabase, user.id);
const { id } = Astro.params;
const errorMessage = Astro.url.searchParams.get('error');

let estimate: Estimate | null = null;
let lineItems: EstimateLineItem[] = [];
let servicePackages: ServicePackage[] = [];
let attachments: EstimateAttachmentWithSignedUrl[] = [];
let notFound = false;

if (membership && id) {
  const estimateRepository = createSupabaseEstimateRepository(Astro.locals.supabase);
  const result = await estimateRepository.getEstimate(membership.businessId, id);

  if (result.ok) {
    estimate = result.estimate;

    const lineItemRepo = createSupabaseEstimateLineItemRepository(
      Astro.locals.supabase,
      estimateRepository,
    );
    const lineItemsResult = await lineItemRepo.listLineItems(membership.businessId, id);
    if (lineItemsResult.ok) lineItems = lineItemsResult.lineItems;

    const servicePackageRepo = createSupabaseServicePackageRepository(Astro.locals.supabase);
    const packagesResult = await servicePackageRepo.listServicePackages(membership.businessId);
    if (packagesResult.ok) servicePackages = packagesResult.servicePackages;

    const attachmentRepo = createSupabaseEstimateAttachmentRepository(Astro.locals.supabase);
    const attachmentsResult = await attachmentRepo.listAttachments(membership.businessId, id);
    if (attachmentsResult.ok) attachments = attachmentsResult.attachments;
  } else {
    notFound = true;
  }
}

const lineItemsSubtotalMinorUnits = lineItems.reduce(
  (sum, item) => sum + item.lineTotal.amountMinorUnits,
  0,
);
const effectiveSubtotalMinorUnits =
  lineItems.length > 0 ? lineItemsSubtotalMinorUnits : (estimate?.proposedAmount.amountMinorUnits ?? 0);

const totals = estimate
  ? calculateEstimateTotals({
      subtotal: createMoney(effectiveSubtotalMinorUnits, createCurrencyCode('USD')),
      taxRateBasisPoints: estimate.taxRateBasisPoints,
      discountAmount: estimate.discountAmount,
      depositAmount: estimate.depositAmount,
    })
  : null;

const isDraft = estimate?.status === 'draft';
const taxRatePercentValue =
  estimate?.taxRateBasisPoints !== undefined ? (estimate.taxRateBasisPoints / 100).toFixed(2) : '';
const discountValue = estimate?.discountAmount
  ? (estimate.discountAmount.amountMinorUnits / 100).toFixed(2)
  : '';
const depositValue = estimate?.depositAmount
  ? (estimate.depositAmount.amountMinorUnits / 100).toFixed(2)
  : '';

const hasActiveApprovalLink = Boolean(
  estimate?.customerApprovalToken &&
    estimate.customerApprovalTokenExpiresAt &&
    new Date(estimate.customerApprovalTokenExpiresAt).getTime() > Date.now(),
);
const approvalLinkUrl =
  hasActiveApprovalLink && estimate?.customerApprovalToken
    ? `${Astro.url.origin}/approve/${estimate.customerApprovalToken}`
    : '';
---

<AdminLayout title="Estimate detail" membership={membership}>
  <p><a href="/leads">&larr; Back to leads</a></p>
  {
    notFound ? (
      <div class="uikit-error-banner" role="alert">
        Estimate not found.
      </div>
    ) : estimate ? (
      <>
        <h1>
          Estimate{' '}
          <span class={`uikit-badge uikit-badge--${estimateStatusTone(estimate.status)}`}>
            {estimate.status}
          </span>
        </h1>
        <dl>
          <dt>Lead</dt>
          <dd>
            <a href={`/leads/${estimate.leadId}`}>{estimate.leadId}</a>
          </dd>
          <dt>Summary</dt>
          <dd>{estimate.summary}</dd>
          <dt>Created</dt>
          <dd>{new Date(estimate.createdAt).toLocaleString()}</dd>
        </dl>

        {errorMessage ? (
          <div class="uikit-error-banner" role="alert">
            {errorMessage}
          </div>
        ) : null}

        <p>
          <a href={`/estimates/${estimate.id}/print`}>Print / Save as PDF</a>
        </p>

        {isDraft ? (
          <div style="margin-bottom: 1.5rem;">
            <form method="POST" action={`/api/estimates/${estimate.id}/approve`} style="display: inline;">
              <button type="submit" class="uikit-button uikit-button--primary">
                Approve estimate
              </button>
            </form>{' '}
            <form method="POST" action={`/api/estimates/${estimate.id}/reject`} style="display: inline;">
              <button type="submit" class="uikit-button uikit-button--secondary">
                Reject estimate
              </button>
            </form>
          </div>
        ) : estimate.status === 'approved' ? (
          <p style="color: var(--color-text-muted); font-size: 0.875rem; margin-bottom: 1.5rem;">
            Approved on {estimate.approvedAt ? new Date(estimate.approvedAt).toLocaleString() : '—'} - line
            items are now immutable.
          </p>
        ) : (
          <p style="color: var(--color-text-muted); font-size: 0.875rem; margin-bottom: 1.5rem;">
            Rejected on {estimate.rejectedAt ? new Date(estimate.rejectedAt).toLocaleString() : '—'} - line
            items are now immutable.
          </p>
        )}

        <h2>Line items</h2>
        {lineItems.length === 0 ? (
          <div class="uikit-empty-state">
            <p class="uikit-empty-state__title">No line items yet</p>
            <p class="uikit-empty-state__description">
              {estimate.summary} - {formatMinorUnitsAsDollars(estimate.proposedAmount.amountMinorUnits, estimate.proposedAmount.currency)}{' '}
              is the original proposed amount from before this estimate had itemized detail.
            </p>
          </div>
        ) : (
          <div class="uikit-table-scroll">
            <table class="uikit-table">
              <thead>
                <tr>
                  <th>Description</th>
                  <th>Qty</th>
                  <th>Unit price</th>
                  <th>Line total</th>
                  {isDraft ? <th /> : null}
                </tr>
              </thead>
              <tbody>
                {lineItems.map((item) => (
                  <tr>
                    <td>{item.description}</td>
                    <td>{item.quantity}</td>
                    <td>{formatMinorUnitsAsDollars(item.unitPrice.amountMinorUnits, item.unitPrice.currency)}</td>
                    <td>{formatMinorUnitsAsDollars(item.lineTotal.amountMinorUnits, item.lineTotal.currency)}</td>
                    {isDraft ? (
                      <td>
                        <form method="POST" action={`/api/estimates/${estimate.id}/line-items/${item.id}/delete`}>
                          <button type="submit" class="uikit-button uikit-button--secondary">
                            Remove
                          </button>
                        </form>
                      </td>
                    ) : null}
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <td colspan={isDraft ? 4 : 3} style="text-align: right; font-weight: 600;">
                    Subtotal
                  </td>
                  <td style="font-weight: 600;">
                    {formatMinorUnitsAsDollars(lineItemsSubtotalMinorUnits, 'USD')}
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        )}

        {isDraft ? (
          <form method="POST" action={`/api/estimates/${estimate.id}/line-items`} style="max-width: 480px;">
            {servicePackages.length > 0 ? (
              <div class="uikit-form-field">
                <label for="servicePackageId">From service package (optional)</label>
                <select id="servicePackageId" name="servicePackageId">
                  <option value="">Custom line item</option>
                  {servicePackages.map((pkg) => (
                    <option value={pkg.id}>
                      {pkg.name} ({formatMinorUnitsAsDollars(pkg.defaultUnitPrice.amountMinorUnits, pkg.defaultUnitPrice.currency)})
                    </option>
                  ))}
                </select>
              </div>
            ) : (
              <p style="color: var(--color-text-muted); font-size: 0.875rem;">
                No service packages yet - <a href="/service-packages">add one</a> to speed up future line
                items, or add a custom line below.
              </p>
            )}
            <div class="uikit-form-field">
              <label for="description">Description</label>
              <input id="description" name="description" type="text" required />
            </div>
            <div class="uikit-form-field">
              <label for="quantity">Quantity</label>
              <input id="quantity" name="quantity" type="number" min="1" step="1" value="1" required />
            </div>
            <div class="uikit-form-field">
              <label for="unitPrice">Unit price (USD)</label>
              <input id="unitPrice" name="unitPrice" type="text" placeholder="150.00" required />
            </div>
            <button type="submit" class="uikit-button uikit-button--secondary">
              Add line item
            </button>
          </form>
        ) : null}

        <h2>Pricing</h2>
        {totals ? (
          <dl>
            <dt>Subtotal</dt>
            <dd>{formatMinorUnitsAsDollars(totals.subtotal.amountMinorUnits, totals.subtotal.currency)}</dd>
            <dt>Discount</dt>
            <dd>
              -{formatMinorUnitsAsDollars(totals.discountAmount.amountMinorUnits, totals.discountAmount.currency)}
            </dd>
            <dt>Tax {estimate.taxRateBasisPoints ? `(${(estimate.taxRateBasisPoints / 100).toFixed(2)}%)` : ''}</dt>
            <dd>{formatMinorUnitsAsDollars(totals.taxAmount.amountMinorUnits, totals.taxAmount.currency)}</dd>
            <dt>Total</dt>
            <dd style="font-weight: 600;">
              {formatMinorUnitsAsDollars(totals.total.amountMinorUnits, totals.total.currency)}
            </dd>
            {totals.depositAmount ? (
              <>
                <dt>Deposit due now</dt>
                <dd>
                  {formatMinorUnitsAsDollars(totals.depositAmount.amountMinorUnits, totals.depositAmount.currency)}
                </dd>
              </>
            ) : null}
          </dl>
        ) : null}

        {isDraft ? (
          <form method="POST" action={`/api/estimates/${estimate.id}/pricing`} style="max-width: 320px;">
            <div class="uikit-form-field">
              <label for="taxRatePercent">Tax rate (%)</label>
              <input
                id="taxRatePercent"
                name="taxRatePercent"
                type="text"
                placeholder="8.25"
                value={taxRatePercentValue}
              />
            </div>
            <div class="uikit-form-field">
              <label for="discountAmount">Discount (USD)</label>
              <input
                id="discountAmount"
                name="discountAmount"
                type="text"
                placeholder="0.00"
                value={discountValue}
              />
            </div>
            <div class="uikit-form-field">
              <label for="depositAmount">Deposit required (USD)</label>
              <input
                id="depositAmount"
                name="depositAmount"
                type="text"
                placeholder="0.00"
                value={depositValue}
              />
            </div>
            <button type="submit" class="uikit-button uikit-button--secondary">
              Update pricing
            </button>
          </form>
        ) : null}

        <h2>Attachments</h2>
        {attachments.length === 0 ? (
          <div class="uikit-empty-state">
            <p class="uikit-empty-state__title">No reference photos yet</p>
            <p class="uikit-empty-state__description">
              Attach photos of the work site or job to reference while pricing this estimate.
            </p>
          </div>
        ) : (
          <ul>
            {attachments.map(({ attachment, signedUrl }) => (
              <li style="margin-bottom: 0.75rem;">
                {signedUrl ? (
                  <a href={signedUrl} target="_blank" rel="noreferrer">
                    {attachment.fileName}
                  </a>
                ) : (
                  <span>{attachment.fileName}</span>
                )}
                {attachment.caption ? <span> - {attachment.caption}</span> : null}{' '}
                <form
                  method="POST"
                  action={`/api/estimates/${estimate.id}/attachments/${attachment.id}/delete`}
                  style="display: inline;"
                >
                  <button type="submit" class="uikit-button uikit-button--secondary">
                    Remove
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}

        <form
          method="POST"
          action={`/api/estimates/${estimate.id}/attachments`}
          enctype="multipart/form-data"
          style="max-width: 480px;"
        >
          <div class="uikit-form-field">
            <label for="file">Photo</label>
            <input id="file" name="file" type="file" accept="image/*" required />
          </div>
          <div class="uikit-form-field">
            <label for="caption">Caption (optional)</label>
            <input id="caption" name="caption" type="text" />
          </div>
          <button type="submit" class="uikit-button uikit-button--secondary">
            Add attachment
          </button>
        </form>

        <h2>Customer approval</h2>
        {estimate.customerApproved ? (
          <p>
            Approved by the customer
            {estimate.customerSignatureName ? ` (${estimate.customerSignatureName})` : ''} on{' '}
            {estimate.approvedAt ? new Date(estimate.approvedAt).toLocaleString() : ''}.
          </p>
        ) : hasActiveApprovalLink ? (
          <>
            <p>Share this link with the customer so they can review and approve the estimate:</p>
            <p>
              <code>{approvalLinkUrl}</code>
            </p>
            <p style="color: var(--color-text-muted); font-size: 0.875rem;">
              Expires {estimate.customerApprovalTokenExpiresAt
                ? new Date(estimate.customerApprovalTokenExpiresAt).toLocaleDateString()
                : ''}.
            </p>
          </>
        ) : (
          <p style="color: var(--color-text-muted); font-size: 0.875rem;">
            No active customer approval link.
          </p>
        )}
        {isDraft ? (
          <form method="POST" action={`/api/estimates/${estimate.id}/generate-approval-link`}>
            <button type="submit" class="uikit-button uikit-button--secondary">
              {hasActiveApprovalLink ? 'Generate a new link' : 'Generate customer approval link'}
            </button>
          </form>
        ) : null}
      </>
    ) : (
      <div class="uikit-error-banner" role="alert">
        Your account has no business membership yet.
      </div>
    )
  }
</AdminLayout>
