---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCurrentMembership } from '../../lib/auth/membership';
import { createSupabaseLeadRepository, createSupabaseAuditLogRepository } from '@ai-company-os/db';
import { leadStatusTone } from '@ai-company-os/ui-kit';
import type { LeadStatus } from '@ai-company-os/core-models';

const user = Astro.locals.user!;
const membership = await getCurrentMembership(Astro.locals.supabase, user.id);

const statusFilter = Astro.url.searchParams.get('status') as LeadStatus | null;
const includeArchived = Astro.url.searchParams.get('includeArchived') === '1';

let leads: Array<{ id: string; status: LeadStatus; createdAt: string; archivedAt?: string }> = [];
let loadError: string | null = null;

if (membership) {
  const auditLog = createSupabaseAuditLogRepository(Astro.locals.supabase);
  const leadRepo = createSupabaseLeadRepository(Astro.locals.supabase, auditLog);
  const result = await leadRepo.listLeads(membership.businessId, {
    status: statusFilter ?? undefined,
    includeArchived,
  });
  if (result.ok) {
    leads = result.leads.map((l) => ({
      id: l.id,
      status: l.status,
      createdAt: l.createdAt,
      archivedAt: l.archivedAt,
    }));
  } else {
    loadError = result.error;
  }
}

const ALL_STATUSES: LeadStatus[] = [
  'new',
  'contact-attempted',
  'contacted',
  'qualified',
  'disqualified',
  'estimate-requested',
  'estimate-sent',
  'booked',
  'lost',
  'spam',
  'duplicate',
];
---

<AdminLayout title="Leads" membership={membership}>
  <h1>Leads</h1>

  <form method="GET" style="margin-bottom: 1rem; max-width: 240px;">
    <div class="uikit-form-field">
      <label for="status">Filter by status</label>
      <select id="status" name="status">
        <option value="">All statuses</option>
        {
          ALL_STATUSES.map((status) => (
            <option value={status} selected={status === statusFilter}>
              {status}
            </option>
          ))
        }
      </select>
    </div>
    <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
      <input type="checkbox" name="includeArchived" value="1" checked={includeArchived} />
      Show archived
    </label>
    <button type="submit" class="uikit-button uikit-button--secondary">Filter</button>
  </form>

  {
    loadError ? (
      <div class="uikit-error-banner" role="alert">
        Could not load leads: {loadError}
      </div>
    ) : leads.length === 0 ? (
      <div class="uikit-empty-state">
        <p class="uikit-empty-state__title">No leads found</p>
        <p class="uikit-empty-state__description">
          {statusFilter
            ? `No leads with status "${statusFilter}".`
            : 'New leads from the public website will appear here once submitted.'}
        </p>
      </div>
    ) : (
      <div class="uikit-table-scroll">
        <table class="uikit-table">
          <thead>
            <tr>
              <th>Status</th>
              <th>Created</th>
              <th>Archived</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {leads.map((lead) => (
              <tr>
                <td>
                  <span class={`uikit-badge uikit-badge--${leadStatusTone(lead.status)}`}>
                    {lead.status}
                  </span>
                </td>
                <td>{new Date(lead.createdAt).toLocaleString()}</td>
                <td>
                  {lead.archivedAt ? (
                    <span class="uikit-badge uikit-badge--neutral">Archived</span>
                  ) : (
                    '—'
                  )}
                </td>
                <td>
                  <a href={`/leads/${lead.id}`}>View</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
