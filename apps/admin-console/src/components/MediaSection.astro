---
import type { PhotoWithSignedUrl } from '@ai-company-os/db';

interface Props {
  jobId: string;
  photos: PhotoWithSignedUrl[];
}

const { jobId, photos } = Astro.props;

const KIND_LABEL: Record<string, string> = {
  before: 'Before',
  progress: 'Progress',
  after: 'After',
};
---

<h2>Media</h2>
<p style="color: var(--color-text-muted); font-size: 0.875rem;">
  Uploaded originals only - no automated privacy processing (metadata stripping, GPS removal,
  face/plate review) runs on these yet, so none are eligible for public publication.
</p>
{
  photos.length === 0 ? (
    <div class="uikit-empty-state">
      <p class="uikit-empty-state__title">No photos yet</p>
    </div>
  ) : (
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
      {photos.map(({ photo, signedUrl }) => (
        <figure style="margin: 0; width: 160px;">
          {signedUrl ? (
            <img
              src={signedUrl}
              alt={photo.altTextDraft ?? `${KIND_LABEL[photo.kind]} photo`}
              style="width: 160px; height: 120px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--color-border);"
            />
          ) : (
            <div
              style="width: 160px; height: 120px; display: flex; align-items: center; justify-content: center; background: var(--color-neutral-bg); border-radius: var(--radius-sm); font-size: 0.75rem; color: var(--color-text-muted);"
            >
              Preview unavailable
            </div>
          )}
          <figcaption style="font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 0.25rem;">
            {KIND_LABEL[photo.kind]}
          </figcaption>
        </figure>
      ))}
    </div>
  )
}
<form method="POST" action={`/api/jobs/${jobId}/photos`} enctype="multipart/form-data" style="max-width: 400px;">
  <div class="uikit-form-field">
    <label for="kind">Photo type</label>
    <select id="kind" name="kind">
      <option value="before">Before</option>
      <option value="progress">Progress</option>
      <option value="after">After</option>
    </select>
  </div>
  <div class="uikit-form-field">
    <label for="file">Photo file</label>
    <input id="file" name="file" type="file" accept="image/*" required />
  </div>
  <button type="submit" class="uikit-button uikit-button--secondary">
    Upload photo
  </button>
</form>
