# Server-only. Same Supabase project apps/greencal-website and
# packages/db's CRM tables already live in - see DECISIONS.md ADR-0011.
#
# Uses the ANON key deliberately, never the service-role key, for
# every normal (authenticated, tenant-scoped) query this app makes -
# see ADR-0010. Configure real values only in Vercel's project
# environment variables (and, for local testing, an untracked .env
# file) - never commit real values here.

# Format: https://<project-ref>.supabase.co - the same value already
# configured for apps/greencal-website's SUPABASE_URL.
SUPABASE_URL=

# The anon/public key for that same project (Settings -> API -> anon
# public). Not the service-role key.
SUPABASE_ANON_KEY=

# The service-role/secret key for that same project (Settings -> API ->
# service_role). Used by exactly one narrow, deliberately scoped route -
# the public customer estimate-approval link (see DECISIONS.md
# ADR-0030 and src/lib/supabase/env.ts's getSupabaseServiceRoleEnv())
# - to look up an Estimate by its token with no authenticated tenant
# session present. Never used for any other route in this app. Treat
# this value with the same care as any other production secret; if it
# is ever exposed, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=
