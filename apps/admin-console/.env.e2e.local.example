# Copy this file to apps/admin-console/.env.e2e.local (same directory
# as this file) and fill in real values - see playwright.config.ts's
# loadE2eEnvFile(). .env.e2e.local is gitignored via the root
# .gitignore's `.env.*.local` rule - never commit it, never paste real
# credentials into a commit message or this example file.
#
# This is the CRM Isolation Test Tenant account (see
# docs/launch/CRM_V1_RELEASE_READINESS.md for the setup record) - never
# the real GreenCal owner account.
#
# Nothing here is optional-by-omission any more. The suite this file
# configures is a release gate, it is only reachable through
# `pnpm --filter @ai-company-os/admin-console run test:e2e:tenant-isolation`
# (playwright.config.ts does not even define the project otherwise), and
# a missing value now fails it loudly rather than skipping it - a gate
# that reports "passed" because it was unconfigured is worse than one
# that fails. The two genuinely optional entries say so explicitly.

# REQUIRED. The current production Admin Console URL (Vercel
# deployment-specific preview URLs change between deployments - confirm
# the current one in the Vercel dashboard rather than reusing an old
# value).
E2E_BASE_URL=https://ai-company-os-admin-console-example.vercel.app

# REQUIRED. The Tenant B login this suite drives the browser as.
E2E_TENANT_B_EMAIL=crm-isolation-test+20260805@example.com
E2E_TENANT_B_PASSWORD=

# Known Tenant A (real GreenCal) record IDs this test attempts to read
# as Tenant B, to prove isolation. Job and Estimate are already known
# from this session's own smoke test - Lead and Invoice must be filled
# in from your own GreenCal owner session before running this test. Any
# left blank annotate the run as a check that was not performed, rather
# than silently passing.
E2E_TENANT_A_JOB_ID=71d8129f-f497-41be-a2a3-5f23bac7ab2b
E2E_TENANT_A_ESTIMATE_ID=cb1a14bf-11d0-4d6f-bb69-e113572e29bf
E2E_TENANT_A_LEAD_ID=
E2E_TENANT_A_INVOICE_ID=

# REQUIRED. Credentials for the fixture provisioner
# (tests/e2e/fixture-provisioner.ts), which runs as its own Playwright
# setup project before the browser suite starts. It calls exactly one
# database function -
# `public.e2e_provision_tenant_isolation_fixture()`, see
# packages/db/migrations/041-e2e-fixture-rpc.sql - which takes no
# arguments and owns the fixture's ids internally, so this path cannot
# be aimed at another business, contact or lead. It holds EXECUTE on
# that one function and no table privilege of any kind. Same Supabase
# project as SUPABASE_URL in apps/admin-console/.env.
#
# NAME CHANGE: this was E2E_SUPABASE_SERVICE_ROLE_KEY. The canonical
# name is now E2E_SUPABASE_SECRET_KEY, and there is deliberately no
# fallback to the old one - a silent fallback would let a stale local
# file keep working while this documented contract said otherwise. If
# your .env.e2e.local still uses the old name, rename the key.
#
# THE VALUE IS A REAL SECRET. Never commit it, never paste it into
# chat, never put it in a browser-visible variable (no NEXT_PUBLIC_ /
# PUBLIC_ prefix, ever). Find it: Supabase dashboard ->
# Greencal-production -> Settings -> API -> service_role secret.
E2E_SUPABASE_URL=
E2E_SUPABASE_SECRET_KEY=

# REQUIRED, and must be exactly the string "true" - not "TRUE", not
# "1", not "yes". A deliberate, separate interlock from the two
# variables above: holding the credential is not the same as intending
# to write with it. Without it the provisioner refuses to call the RPC
# at all, and the whole suite stops before the browser opens.
#
# The bound on what it permits is the database function, not this flag:
# that function can only ever create/verify one fixed synthetic Contact
# and Lead inside the crm-isolation-test-tenant business, and fails
# closed if that tenant's row is missing, renamed or re-slugged. It
# cannot reach GreenCal, Navarro, or any other business.
E2E_ALLOW_FIXTURE_MUTATION=

# Optional: Vercel Deployment Protection (SSO) automation bypass
# secret, generated from the Vercel project's Settings > Deployment
# Protection > Protection Bypass for Automation. Required only if
# E2E_BASE_URL points at a deployment with protection enabled (e.g. a
# preview URL) - sent as the `x-vercel-protection-bypass` header on
# every request in this project, without disabling protection itself.
# Leave blank if E2E_BASE_URL is an unprotected/production domain.
VERCEL_AUTOMATION_BYPASS_SECRET=
