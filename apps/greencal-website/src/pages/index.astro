---
// Premium homepage - visual/conversion refinement phase (2026-07-27),
// on Vercel Preview only. See docs/GREENCAL_VISUAL_REFINEMENT_PLAN.md
// and docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md. Only this page's
// structure changed; every other route is unchanged this stage.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/homepage/Hero.astro';
import PersistentEstimateCta from '../components/homepage/PersistentEstimateCta.astro';
import TrustStrip from '../components/homepage/TrustStrip.astro';
import CustomerSegmentSection from '../components/homepage/CustomerSegmentSection.astro';
import ServiceGridSection from '../components/homepage/ServiceGridSection.astro';
import CommercialSection from '../components/homepage/CommercialSection.astro';
import HOASection from '../components/homepage/HOASection.astro';
import BeforeAfter from '../components/homepage/BeforeAfter.astro';
import WhyChooseGreenCal from '../components/homepage/WhyChooseGreenCal.astro';
import SafetySection from '../components/homepage/SafetySection.astro';
import ProcessSteps from '../components/homepage/ProcessSteps.astro';
import Testimonials from '../components/homepage/Testimonials.astro';
import ServiceAreaSection from '../components/homepage/ServiceAreaSection.astro';
import FinalCta from '../components/homepage/FinalCta.astro';
import { servicesByCategory } from '../data/services';

const title = 'GreenCal Pressure Washing';
const description = `Residential, commercial, and multi-family exterior cleaning serving approved communities across San Diego, Orange, and Riverside Counties.`;

const residential = servicesByCategory('residential');
---

<BaseLayout title={title} description={description} path="/">
  <Hero />
  <PersistentEstimateCta />
  <TrustStrip />
  <CustomerSegmentSection />

  <ServiceGridSection
    id="residential-heading"
    heading="Residential Services"
    intro="Roof, house, and concrete cleaning for homeowners across the approved service area."
    services={residential}
    viewAllRoute="/residential"
    viewAllLabel="All Residential Services"
    icon="roof"
    cardSize="featured"
  />

  <CommercialSection />
  <HOASection />
  <BeforeAfter />
  <WhyChooseGreenCal />
  <SafetySection />
  <ProcessSteps />
  <Testimonials />
  <ServiceAreaSection />
  <FinalCta />
</BaseLayout>
