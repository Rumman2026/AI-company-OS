---
import { siteInfo } from '../data/site';
---

<div class="utility-bar">
  <div class="utility-bar-inner container-wide">
    <p class="utility-bar-message">
      Serving Southern California - Residential, Commercial &amp; HOA Exterior Cleaning
    </p>
    <div class="utility-bar-actions">
      <a href={siteInfo.phoneHref}>Call {siteInfo.phoneDisplay}</a>
      <a href="/contact-us#quote-form">Request Estimate</a>
    </div>
  </div>
</div>

<style>
  .utility-bar {
    background-color: var(--color-forest-900);
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--font-size-xs);
    min-height: var(--utility-bar-height);
  }

  .utility-bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-1);
  }

  .utility-bar-message {
    margin: 0;
  }

  .utility-bar-actions {
    display: flex;
    gap: var(--space-4);
  }

  .utility-bar-actions a {
    color: var(--color-white);
    font-weight: 600;
    text-decoration: none;
  }

  .utility-bar-actions a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .utility-bar-message {
      display: none;
    }
  }
</style>
