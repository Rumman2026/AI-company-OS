---
// Real GreenCal logo (Logo Integration Pass, 2026-07-29). The owner
// supplied two color variants of the same illustrated mark, identical
// except for the "GreenCal Pressure Washing" tagline text color: black
// (reads correctly on the light header) and white (reads correctly on
// the dark-green footer) - trimmed of surrounding transparent padding
// and re-encoded as WebP, otherwise pixel-identical to the supplied
// artwork (no redraw/recreation). Originals preserved untouched at
// public/assets/greencal/logo/. No icon-only file exists, so the
// favicon is intentionally not changed here - see
// docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md.
export interface Props {
  variant?: 'default' | 'inverse';
  /** 'large' is used for placements like the footer where the logo should read as a real logo, not a nav-bar mark. */
  size?: 'default' | 'large';
  /**
   * Tests key off a single, unique `.brand` element (tab-order and
   * focus-visibility checks) - only the header's instance should set
   * this. Leave false for any other placement (e.g. the footer).
   */
  isSiteBrand?: boolean;
}

const { variant = 'default', size = 'default', isSiteBrand = false } = Astro.props;

// Real trimmed source is 800x560 (5:3.5, ~1.43:1) for both variants -
// used as the base width/height attributes (CLS prevention); CSS below
// controls the actual displayed size per size/breakpoint via height +
// width: auto, preserving this exact aspect ratio at every size.
const LOGO_SRC = {
  default: '/assets/greencal/generated/logo/header.webp',
  inverse: '/assets/greencal/generated/logo/footer.webp',
};
---

<a
  href="/"
  class={`wordmark wordmark-${variant} wordmark-${size} ${isSiteBrand ? 'brand' : ''}`}
  aria-label="GreenCal Pressure Washing home">
  <img
    src={LOGO_SRC[variant]}
    alt="GreenCal Pressure Washing"
    width="800"
    height="560"
    class="wordmark-logo"
  />
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .wordmark-logo {
    display: block;
    width: auto;
    height: 44px;
  }

  @media (min-width: 1280px) {
    .wordmark-logo {
      height: 52px;
    }
  }

  .wordmark-large .wordmark-logo {
    height: 64px;
  }

  @media (min-width: 1280px) {
    .wordmark-large .wordmark-logo {
      height: 88px;
    }
  }
</style>
