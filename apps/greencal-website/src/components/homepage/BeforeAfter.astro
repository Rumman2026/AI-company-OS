---
// Real Photo Integration Pass (2026-07-26): all 3 projects now use real
// GreenCal residential photos (getMediaById) instead of illustrative
// placeholder categories. No city, customer name, or technical
// treatment claim is attached - none were verified for these photos
// (the prior phase's "Irvine, California" placeholder text is removed
// for the same reason: it was acceptable only as an explicitly-labeled
// illustrative example next to a placeholder image, not next to a real
// photo, where a city would misrepresent a real project's location).
// Descriptions use exactly the neutral, owner-approved wording supplied
// for this pass. Roof Washing is featured (the most visually dramatic
// transformation); House Washing and Concrete Cleaning are supporting
// cards, per the requested "featured + two supporting" composition.
import BeforeAfterSlider from './BeforeAfterSlider.astro';
import { getMediaById } from '../../data/media';

interface FeaturedProject {
  id: string;
  title: string;
  surfaceType: string;
  description: string;
  beforeMediaId: string;
  afterMediaId: string;
  featured?: boolean;
  relatedServiceHref?: string;
}

const projects: FeaturedProject[] = [
  {
    id: 'roof-washing',
    title: 'Roof Washing',
    surfaceType: 'Concrete Tile Roof',
    description: 'Before-and-after view of a GreenCal residential roof-washing project.',
    beforeMediaId: 'roof-wash-01-before',
    afterMediaId: 'roof-wash-01-after',
    featured: true,
    relatedServiceHref: '/services/roof-cleaning',
  },
  {
    id: 'house-washing',
    title: 'House Washing',
    surfaceType: 'Stucco Exterior',
    description: 'Before-and-after view of a GreenCal residential house-washing project.',
    beforeMediaId: 'house-wash-01-before',
    afterMediaId: 'house-wash-01-after',
  },
  {
    id: 'concrete-cleaning',
    title: 'Concrete Cleaning',
    surfaceType: 'Driveway Concrete',
    description: 'Before-and-after view of a GreenCal residential driveway-cleaning project.',
    beforeMediaId: 'concrete-cleaning-01-before',
    afterMediaId: 'concrete-cleaning-01-after',
  },
];
---

<section class="before-after" aria-labelledby="before-after-heading">
  <div class="container-wide">
    <p class="before-after-eyebrow">Authentic Project Proof</p>
    <h2 id="before-after-heading" class="section-heading">Real Results</h2>
    <p class="before-after-intro">
      Real GreenCal residential before-and-after projects. Drag or use the slider to compare.
    </p>
    <div class="before-after-grid">
      {
        projects.map((project) => (
          <BeforeAfterSlider
            id={project.id}
            title={project.title}
            surfaceType={project.surfaceType}
            description={project.description}
            beforeMedia={getMediaById(project.beforeMediaId)}
            afterMedia={getMediaById(project.afterMediaId)}
            featured={project.featured}
            relatedServiceHref={project.relatedServiceHref}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .before-after {
    padding-block: var(--space-7);
  }

  .before-after-eyebrow {
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-700);
    margin: 0 0 var(--space-2);
  }

  .before-after-intro {
    max-width: 42rem;
    color: var(--color-charcoal-600);
    font-size: var(--font-size-lg);
    margin-block-end: var(--space-5);
  }

  .before-after-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .before-after-grid {
      /* The featured project (grid-column: 1 / -1, see
         BeforeAfterSlider.astro) spans this full row; the two
         supporting cards then flow into a fixed two-column row below. */
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
