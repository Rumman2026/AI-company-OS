---
// Three featured project *categories*, not real completed jobs - no
// real before/after photos or verified project records exist in this
// repository (docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md). The
// "Irvine" example below is the exact illustrative example given in
// the refinement brief itself (and Irvine is a real, approved city -
// see BUSINESS_FACTS.md) - used only as generic, process-descriptive
// placeholder copy, never presented as a specific verified past job.
// The other two categories intentionally omit a specific city, since
// no city was supplied for them and inventing one would misrepresent
// a real completed project.
import BeforeAfterSlider from './BeforeAfterSlider.astro';

interface FeaturedProject {
  id: string;
  title: string;
  city?: string;
  surfaceType: string;
  description: string;
  featured?: boolean;
  relatedServiceHref?: string;
}

const projects: FeaturedProject[] = [
  {
    id: 'roof-washing',
    title: 'Concrete Tile Roof Cleaning',
    city: 'Irvine, California',
    surfaceType: 'Concrete Tile Roof',
    description: 'Organic buildup removed using a surface-appropriate, low-pressure cleaning process.',
    featured: true,
    relatedServiceHref: '/services/roof-cleaning',
  },
  {
    id: 'residential-concrete',
    title: 'Residential Concrete Cleaning',
    surfaceType: 'Driveway & Walkway Concrete',
    description: 'Dirt and staining removed from residential concrete surfaces.',
  },
  {
    id: 'commercial-flatwork',
    title: 'Commercial Flatwork Cleaning',
    surfaceType: 'Commercial Concrete Flatwork',
    description: 'Grime and buildup removed from commercial walkways and parking-area concrete.',
  },
];
---

<section class="before-after" aria-labelledby="before-after-heading">
  <div class="container-wide">
    <h2 id="before-after-heading" class="section-heading">Real Results</h2>
    <p class="before-after-intro">
      Real, owner-approved before-and-after project photography will appear here as it becomes
      available. The categories below show how each project will be presented.
    </p>
    <div class="before-after-grid">
      {
        projects.map((project) => (
          <BeforeAfterSlider
            id={project.id}
            title={project.title}
            city={project.city}
            surfaceType={project.surfaceType}
            description={project.description}
            featured={project.featured}
            relatedServiceHref={project.relatedServiceHref}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .before-after {
    padding-block: var(--space-7);
  }

  .before-after-intro {
    max-width: 42rem;
    color: var(--color-charcoal-600);
    font-size: var(--font-size-lg);
    margin-block-end: var(--space-5);
  }

  .before-after-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .before-after-grid {
      /* The featured project (grid-column: 1 / -1, see
         BeforeAfterSlider.astro) spans this full row; the two
         supporting cards then flow into a fixed two-column row below. */
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
