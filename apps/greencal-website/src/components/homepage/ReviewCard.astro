---
export interface Props {
  displayName: string;
  city?: string;
  servicePerformed: string;
  starRating: number;
  reviewText: string;
  source: string;
  date: string;
  verifiedLink?: string;
  isPlaceholder: boolean;
}

const { displayName, city, servicePerformed, starRating, reviewText, source, date, verifiedLink, isPlaceholder } =
  Astro.props;
---

<article class="review-card" data-placeholder={isPlaceholder ? 'true' : 'false'}>
  {isPlaceholder && <p class="review-placeholder-tag">Development placeholder - not a real review</p>}
  <div class="review-stars" aria-label={`${starRating} out of 5 stars`}>
    {Array.from({ length: 5 }).map((_, index) => (
      <svg viewBox="0 0 20 20" fill={index < starRating ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1" aria-hidden="true">
        <path d="M10 1l2.6 5.6 6.1.6-4.6 4.2 1.3 6.1L10 14.8 4.6 17.5l1.3-6.1L1.3 7.2l6.1-.6z" />
      </svg>
    ))}
  </div>
  <p class="review-text">{reviewText}</p>
  <div class="review-attribution">
    <p class="review-author">{displayName}{city && `, ${city}`}</p>
    <p class="review-meta">
      {servicePerformed} - {source} - {date}
      {verifiedLink && (
        <>
          {' '}
          - <a href={verifiedLink}>Verified</a>
        </>
      )}
    </p>
  </div>
</article>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--color-white);
    border: 1px solid var(--color-cream-100);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .review-placeholder-tag {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gold-700);
  }

  .review-stars {
    display: flex;
    gap: 2px;
  }

  .review-stars svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-gold-500);
  }

  .review-text {
    color: var(--color-charcoal-900);
    flex: 1;
  }

  .review-author {
    font-weight: 700;
    color: var(--color-forest-900);
    margin: 0;
  }

  .review-meta {
    font-size: var(--font-size-sm);
    color: var(--color-charcoal-600);
    margin: 0;
  }
</style>
