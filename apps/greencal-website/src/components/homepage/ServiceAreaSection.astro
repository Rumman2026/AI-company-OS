---
// Curated, approved-only city display (BUSINESS_FACTS.md/ADR-0007).
// "Riverside" (the city itself), "Menifee," and "Anaheim" requested in
// the refinement brief are NOT in the approved 80-city list and are
// omitted - see docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md.
// San Bernardino County is not approved, and the county immediately
// north of Orange County is permanently excluded per ADR-0007 - see
// docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md. Neither appears here.
// City names are plain text, not individual links - per ADR-0007,
// individual city pages stay noindex/draft until real per-city content
// exists; only the county-level pages (already indexable) are linked.
import ServiceAreaGroup from './ServiceAreaGroup.astro';

const groups = [
  {
    countyName: 'Riverside County',
    countyHref: '/service-areas/riverside-county',
    cities: ['Moreno Valley', 'Corona', 'Perris', 'Murrieta', 'Temecula'],
  },
  {
    countyName: 'Orange County',
    countyHref: '/service-areas/orange-county',
    cities: ['Irvine', 'Santa Ana', 'Tustin', 'Costa Mesa', 'Huntington Beach'],
  },
  {
    countyName: 'San Diego County',
    countyHref: '/service-areas/san-diego-county',
    cities: ['San Diego', 'Carlsbad', 'Encinitas', 'Escondido', 'Poway'],
  },
];
---

<section class="service-area-section" aria-labelledby="service-area-heading">
  <div class="container-wide">
    <h2 id="service-area-heading" class="section-heading">Service Areas</h2>
    <p class="service-area-intro">
      Serving approved communities across San Diego, Orange, and Riverside Counties.
    </p>
    <div class="service-area-groups">
      {groups.map((group) => <ServiceAreaGroup {...group} />)}
    </div>
    <p class="service-area-capability-note">
      Large commercial and multi-location projects may be available outside the standard service
      area.
    </p>
    <p>
      <a href="/service-areas" class="btn btn-secondary">View Full Service-Area List</a>
    </p>
  </div>
</section>

<style>
  .service-area-section {
    padding-block: var(--space-7);
    background-color: var(--color-cream-50);
  }

  .service-area-intro {
    color: var(--color-charcoal-600);
    font-size: var(--font-size-lg);
    max-width: 36rem;
    margin-block-end: var(--space-5);
  }

  .service-area-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    margin-block-end: var(--space-4);
  }

  .service-area-capability-note {
    font-size: var(--font-size-sm);
    color: var(--color-charcoal-600);
    font-style: italic;
    margin-block-end: var(--space-4);
  }
</style>
