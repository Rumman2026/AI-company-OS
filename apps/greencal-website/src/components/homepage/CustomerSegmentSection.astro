---
import CustomerSegmentCard from './CustomerSegmentCard.astro';
---

<section class="customer-segments" aria-labelledby="customer-segments-heading">
  <div class="container-wide">
    <h2 id="customer-segments-heading" class="section-heading">Who We Serve</h2>
    <div class="customer-segments-grid">
      <CustomerSegmentCard
        title="Residential"
        description="For homeowners needing roof, house, and concrete exterior cleaning."
        examples={['Roof Cleaning', 'House Washing', 'Concrete, Driveway & Patio Cleaning']}
        learnMoreHref="/residential"
        estimateLabel="Request Estimate"
        icon="roof"
      />
      <CustomerSegmentCard
        title="Commercial"
        description="For gas stations, shopping centers, storefronts, warehouses, restaurants, and other commercial properties needing recurring exterior maintenance."
        examples={[
          'Commercial Building Washing',
          'Storefront Cleaning',
          'Commercial Concrete, Dumpster Pad & Drive-Thru Cleaning',
          'Recurring Maintenance Plans',
        ]}
        learnMoreHref="/commercial"
        estimateLabel="Request Assessment"
        icon="building"
        statusLabel="Commercial Project Media Coming Soon"
      />
      <CustomerSegmentCard
        title="Multi-Family & HOA"
        description="For apartments, condominiums, and HOA communities needing building and shared common-area exterior cleaning."
        examples={[
          'Apartment & Condo Exterior Cleaning',
          'HOA Common-Area Cleaning',
          'Recurring Community Maintenance',
        ]}
        learnMoreHref="/multi-family-hoa"
        estimateLabel="Request Proposal"
        icon="community"
        statusLabel="Commercial Project Media Coming Soon"
      />
    </div>
  </div>
</section>

<style>
  .customer-segments {
    padding-block: var(--space-7);
  }

  .customer-segments-grid {
    display: grid;
    /* Fixed 1/2/3-column steps rather than auto-fit: auto-fit with this
       card's real content width produced a 2-then-1 wrap at common
       desktop widths (Residential + Commercial on one row, Multi-Family
       & HOA alone below) - the exact "unbalanced customer-segment
       section" complaint this phase reported. A fixed breakpoint makes
       the three-equal-column layout deterministic instead of
       content-dependent. */
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-block-start: var(--space-5);
  }

  @media (min-width: 640px) {
    .customer-segments-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .customer-segments-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
