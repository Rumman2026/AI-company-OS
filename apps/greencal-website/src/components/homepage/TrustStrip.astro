---
// Two of the refinement brief's five suggested items - "Hot-Water
// Cleaning Available" and "Water Reclamation Available" - are excluded:
// no evidence exists in this repository that GreenCal offers either
// (see docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md). Substituted with
// two claims this site can already support without new evidence.
// "licensed/insured/bonded/certified/top-rated/award-winning" are
// never stated anywhere, per the brief's own instruction.
const items: Array<{ label: string; icon: string }> = [
  { label: 'Residential & Commercial Experience', icon: 'M4 21V9l8-6 8 6v12M9 21v-6h6v6' },
  { label: 'Surface-Appropriate Cleaning Methods', icon: 'M4 8h16M4 12h16M4 16h16' },
  {
    label: 'Before-and-After Documentation',
    icon: 'M4 8h3l2-2h6l2 2h3v11H4zM12 17a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
  },
  { label: 'Clear, Professional Communication', icon: 'M4 5h16v10H7l-3 3z' },
  {
    label: 'Multi-Family & HOA Capability',
    icon: 'M4 20v-6a4 4 0 014-4h0a4 4 0 014 4v6M12 20v-8a4 4 0 014-4h0a4 4 0 014 4v8',
  },
];
---

<section class="trust-strip" aria-label="Why property owners choose GreenCal">
  <ul class="trust-strip-list">
    {
      items.map((item) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d={item.icon} stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust-strip {
    background-color: var(--color-cream-100);
    padding-block: var(--space-5);
  }

  .trust-strip-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .trust-strip-list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-forest-900);
  }

  .trust-strip-list svg {
    width: 2rem;
    height: 2rem;
    color: var(--color-gold-700);
  }
</style>
