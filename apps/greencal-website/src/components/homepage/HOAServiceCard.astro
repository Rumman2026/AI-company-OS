---
import ResponsiveImage from '../ResponsiveImage.astro';

export interface Props {
  title: string;
  description: string;
  examples: string[];
  ctaLabel: string;
  ctaHref: string;
  icon: 'roof' | 'wall' | 'concrete' | 'building' | 'community' | 'camera';
}

const { title, description, examples, ctaLabel, ctaHref, icon } = Astro.props;
---

<article class="hoa-card">
  <div class="hoa-card-media">
    <ResponsiveImage fallbackLabel={`Photo needed: ${title}`} icon={icon} categoryLabel={title} fill />
  </div>
  <div class="hoa-card-body">
    <h3>{title}</h3>
    <p>{description}</p>
    <ul>
      {examples.map((example) => <li>{example}</li>)}
    </ul>
    <a href={ctaHref} class="btn btn-secondary">{ctaLabel}</a>
  </div>
</article>

<style>
  .hoa-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-cream-100);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  /* Editorial, image-led layout at wider widths - deliberate variety
     from the vertical-stack card pattern used elsewhere, per the Phase
     2 "controlled layout variety" requirement, and gives this section
     more visual weight than a plain repeated card. */
  .hoa-card-media {
    position: relative;
  }

  @media (min-width: 640px) {
    .hoa-card {
      flex-direction: row;
      align-items: stretch;
    }

    .hoa-card-media {
      /* min-width: 0 defeats the flex default of min-width: auto, which
         would otherwise let the media column's content force it wider
         than this flex-basis (the exact bug this fixes: the fill-mode
         image below has no intrinsic size of its own, so this alone is
         enough once combined with `fill` instead of a fixed ratio). */
      flex: 0 0 42%;
      min-width: 0;
    }
  }

  .hoa-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hoa-card-body h3 {
    font-size: var(--font-size-xl);
    font-family: var(--font-family-display);
    color: var(--color-forest-900);
    margin-block: 0 var(--space-3);
  }

  .hoa-card-body p {
    font-size: var(--font-size-lg);
    color: var(--color-charcoal-600);
    margin-block-end: var(--space-3);
  }

  .hoa-card-body ul {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    font-size: var(--font-size-base);
    color: var(--color-charcoal-900);
    flex: 1;
  }

  .hoa-card-body li {
    padding-inline-start: var(--space-3);
    position: relative;
  }

  .hoa-card-body li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background-color: var(--color-gold-500);
  }
</style>
