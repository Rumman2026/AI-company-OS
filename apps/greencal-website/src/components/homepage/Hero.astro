---
// Split-layout, image-led hero (visual-refinement phase). No real hero
// photo exists in this repository - see
// docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md. ResponsiveImage renders
// the honest dark-toned placeholder until one is approved; swapping in
// a real photo later is a one-prop change (pass `media`), not a
// markup change.
import { siteInfo } from '../../data/site';
import ResponsiveImage from '../ResponsiveImage.astro';
---

<section class="hero full-bleed" aria-labelledby="hero-heading">
  <div class="hero-inner container-wide">
    <div class="hero-copy">
      <p class="hero-eyebrow">Professional Exterior Cleaning in Southern California</p>
      <h1 id="hero-heading">Restore Your Property Without Risking Damage</h1>
      <p class="hero-subhead">
        Professional roof washing, house washing, concrete cleaning, and commercial property
        maintenance for homeowners, businesses, HOAs, and property managers across Southern
        California.
      </p>
      <div class="hero-actions">
        <a href="/contact-us#quote-form" class="btn btn-primary btn-lg">Get a Free Estimate</a>
        <a href={siteInfo.phoneHref} class="btn btn-inverse btn-lg">Call {siteInfo.phoneDisplay}</a>
      </div>
      <p class="hero-secondary-link">
        <a href="/contact-us#quote-form">Request a Commercial Assessment</a>
      </p>
      <ul class="hero-trust-indicators">
        <li>Residential &amp; Commercial</li>
        <li>Multi-Family &amp; HOA</li>
        <li>Property-Conscious Methods</li>
      </ul>
    </div>
    <div class="hero-media">
      <ResponsiveImage
        fallbackLabel="Hero photo needed: technician performing exterior cleaning"
        icon="building"
        tone="dark"
        categoryLabel="Exterior Cleaning Project"
        fill
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, var(--color-forest-900) 0%, var(--color-forest-700) 100%);
    color: var(--color-white);
    padding-block: var(--space-7);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
  }

  .hero-eyebrow {
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-500);
    margin-block-end: var(--space-3);
  }

  .hero h1 {
    font-family: var(--font-family-display);
    font-size: var(--font-size-hero);
    line-height: 1.05;
    margin-block: 0 var(--space-4);
  }

  .hero-subhead {
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.88);
    max-width: 34rem;
    margin-block-end: var(--space-5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }

  .hero-secondary-link {
    margin-block: 0 var(--space-5);
  }

  .hero-secondary-link a {
    color: var(--color-white);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero-trust-indicators {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-trust-indicators li {
    padding-inline-start: var(--space-4);
    position: relative;
  }

  .hero-trust-indicators li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-gold-500);
  }

  .hero-media {
    position: relative;
    /* A real, intentional media aspect ratio (4/3) instead of an
       arbitrary min-height blob - Phase 2 "hero media readiness"
       requirement. Still sized against the column's own width, not the
       hero's overall height, so it scales naturally with the grid. */
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  /* ~48% of the desktop hero is visual (hero-media column plus its
     share of the gap), per the phase's 45-55% requirement. */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-media {
      aspect-ratio: 3/2;
      order: -1;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-6) var(--space-5);
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
