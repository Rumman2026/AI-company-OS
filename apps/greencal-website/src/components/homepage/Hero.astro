---
// Split-layout, image-led hero. Hero Correction Pass (2026-07-27):
// swapped to the dedicated roof-wash-hero-after photo (1264x848,
// landscape ~3:2) - a purpose-cropped landscape export supplied
// specifically for this slot, replacing the earlier concrete-cleaning
// photo. One source image is used at every breakpoint; only CSS
// object-position changes responsively (see .hero-media img rules
// below) - no separate mobile/tablet image exists or is needed. This
// is a residential photo - the "REAL GREENCAL PROJECT" label makes no
// commercial claim.
import { siteInfo } from '../../data/site';
import ResponsiveImage from '../ResponsiveImage.astro';
import { getMediaById } from '../../data/media';

const heroMedia = getMediaById('roof-wash-hero-after');
---

<section class="hero full-bleed" aria-labelledby="hero-heading">
  <div class="hero-inner container-wide">
    <div class="hero-copy">
      <p class="hero-eyebrow">Professional Exterior Cleaning in Southern California</p>
      <h1 id="hero-heading">Restore Your Property Without Risking Damage</h1>
      <p class="hero-subhead">
        Professional roof washing, house washing, concrete cleaning, and commercial property
        maintenance for homeowners, businesses, HOAs, and property managers across Southern
        California.
      </p>
      <div class="hero-actions">
        <a href="/contact-us#quote-form" class="btn btn-primary btn-lg">Get a Free Estimate</a>
        <a href={siteInfo.phoneHref} class="btn btn-inverse btn-lg">Call {siteInfo.phoneDisplay}</a>
      </div>
      <p class="hero-secondary-link">
        <a href="/contact-us#quote-form">Request a Commercial Assessment</a>
      </p>
      <ul class="hero-trust-indicators">
        <li>Residential &amp; Commercial</li>
        <li>Multi-Family &amp; HOA</li>
        <li>Property-Conscious Methods</li>
      </ul>
    </div>
    <div class="hero-media">
      <ResponsiveImage
        media={heroMedia}
        fallbackLabel="Hero photo needed: technician performing exterior cleaning"
        icon="building"
        tone="dark"
        categoryLabel="Exterior Cleaning Project"
        sizes="(max-width: 900px) 100vw, 50vw"
        fill
        loading="eager"
      />
      {heroMedia && <span class="hero-media-badge">Real GreenCal Project</span>}
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, var(--color-forest-900) 0%, var(--color-forest-700) 100%);
    color: var(--color-white);
    padding-block: var(--space-7);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
  }

  .hero-eyebrow {
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* Phase 7 (Master Completion Workflow, 2026-07-29): a real WCAG
       contrast gap, not the shared --color-gold-500 token - verified by
       sampling the actual rendered pixel color behind this text
       (~rgb(22,48,36), close to forest-900) at 4.58:1, just barely over
       AA's 4.5:1 floor for this text's size/weight - and the hero's
       160deg gradient runs toward the lighter forest-700 at its far
       edge, where gold-500 drops to 3.25:1 (fails). This lightened value
       passes AA (4.5:1+) against both gradient stops with real margin,
       scoped to this component only - --color-gold-500 itself stays
       unchanged for every other (already-passing) use of it. */
    color: #d4ad74;
    margin-block-end: var(--space-3);
  }

  .hero h1 {
    font-family: var(--font-family-display);
    font-size: var(--font-size-hero);
    line-height: 1.05;
    margin-block: 0 var(--space-4);
  }

  .hero-subhead {
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.88);
    max-width: 34rem;
    margin-block-end: var(--space-5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }

  .hero-secondary-link {
    margin-block: 0 var(--space-5);
  }

  /* Phase 5 (Master Completion Workflow, 2026-07-29): dimmed from solid
     white/font-weight 600 - at full white it read as a near-equal 3rd
     CTA competing with the two buttons above it. Matches the trust
     indicators' opacity below it instead, so the visual hierarchy is
     unambiguous: primary button > secondary button > this tertiary
     link > trust indicators. */
  .hero-secondary-link a {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero-secondary-link a:hover {
    color: var(--color-white);
  }

  .hero-trust-indicators {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-trust-indicators li {
    padding-inline-start: var(--space-4);
    position: relative;
  }

  .hero-trust-indicators li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-gold-500);
  }

  .hero-media {
    position: relative;
    /* A real, intentional media aspect ratio (4/3) instead of an
       arbitrary min-height blob - Phase 2 "hero media readiness"
       requirement. Still sized against the column's own width, not the
       hero's overall height, so it scales naturally with the grid. */
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  /* One source photo (roof-wash-hero-after, ~3:2 landscape) at every
     breakpoint - only object-position changes responsively to keep the
     roof ridge/tile detail centered as the crop narrows from the wide
     desktop panel down to the taller mobile one. Scoped to this
     component's own image only (:global reaches into ResponsiveImage's
     rendered <img>) - does not affect any other fill-mode image
     elsewhere on the page. */
  .hero-media :global(img) {
    object-position: center center;
  }

  @media (max-width: 640px) {
    .hero-media :global(img) {
      object-position: 60% center;
    }
  }

  .hero-media-badge {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
    background-color: rgba(20, 42, 32, 0.75);
    border-radius: var(--radius-full);
  }

  /* ~48% of the desktop hero is visual (hero-media column plus its
     share of the gap), per the phase's 45-55% requirement. */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-media {
      aspect-ratio: 3/2;
      order: -1;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-6) var(--space-5);
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
