---
// Split-layout, image-led hero. Hero Correction Pass (2026-07-27):
// swapped to the dedicated roof-wash-hero-after photo (1264x848,
// landscape ~3:2) - a purpose-cropped landscape export supplied
// specifically for this slot, replacing the earlier concrete-cleaning
// photo. One source image is used at every breakpoint; only CSS
// object-position changes responsively (see .hero-media img rules
// below) - no separate mobile/tablet image exists or is needed. This
// is a residential photo - the "REAL GREENCAL PROJECT" label makes no
// commercial claim.
//
// Premium Visual Redesign (2026-07-29): added a dimensional frame
// (perspective tilt + elevation-3 shadow, desktop-only) around the same
// hero photo, plus a small floating proof card layered over its corner
// using the real roof-wash-01 before/after pair (the same photos the
// Real Results section uses) - not a new asset, not a slider (that
// interaction is reserved for Real Results itself). The proof card only
// renders at >=900px: at a compact-enough size to read as premium it
// doesn't fit legibly on a phone screen without becoming the "tiny
// proof card" the brief explicitly avoids, so it's simplified away
// entirely on mobile rather than shrunk.
import { siteInfo } from '../../data/site';
import ResponsiveImage from '../ResponsiveImage.astro';
import { getMediaById } from '../../data/media';

const heroMedia = getMediaById('roof-wash-hero-after');
const proofBefore = getMediaById('roof-wash-01-before');
const proofAfter = getMediaById('roof-wash-01-after');
---

<section class="hero full-bleed" aria-labelledby="hero-heading">
  <div class="hero-inner container-wide">
    <div class="hero-copy">
      <p class="hero-eyebrow">Professional Exterior Cleaning in Southern California</p>
      <h1 id="hero-heading">Restore Your Property Without Risking Damage</h1>
      <p class="hero-subhead">
        Professional roof washing, house washing, concrete cleaning, and commercial property
        maintenance for homeowners, businesses, HOAs, and property managers across Southern
        California.
      </p>
      <div class="hero-actions">
        <a href="/contact-us#quote-form" class="btn btn-primary btn-lg">Get a Free Estimate</a>
        <a href={siteInfo.phoneHref} class="btn btn-inverse btn-lg">Call {siteInfo.phoneDisplay}</a>
      </div>
      <p class="hero-secondary-link">
        <a href="/contact-us#quote-form">Request a Commercial Assessment</a>
      </p>
      <ul class="hero-trust-indicators">
        <li>Residential &amp; Commercial</li>
        <li>Multi-Family &amp; HOA</li>
        <li>Property-Conscious Methods</li>
      </ul>
    </div>
    <div class="hero-visual">
      <div class="hero-media">
        <ResponsiveImage
          media={heroMedia}
          fallbackLabel="Hero photo needed: technician performing exterior cleaning"
          icon="building"
          tone="dark"
          categoryLabel="Exterior Cleaning Project"
          sizes="(max-width: 900px) 100vw, 50vw"
          fill
          loading="eager"
        />
        {heroMedia && <span class="hero-media-badge">Real GreenCal Project</span>}
      </div>
      {
        proofBefore && proofAfter && (
          <div class="hero-proof-card" aria-hidden="false">
            <p class="hero-proof-card-label">Real Before &amp; After</p>
            <div class="hero-proof-card-images">
              <div class="hero-proof-thumb">
                <ResponsiveImage media={proofBefore} fallbackLabel="Before photo" ratio="1/1" />
                <span class="hero-proof-thumb-tag">Before</span>
              </div>
              <div class="hero-proof-thumb">
                <ResponsiveImage media={proofAfter} fallbackLabel="After photo" ratio="1/1" />
                <span class="hero-proof-thumb-tag">After</span>
              </div>
            </div>
            <p class="hero-proof-card-caption">Roof Washing - Concrete Tile</p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, var(--color-forest-900) 0%, var(--color-forest-700) 100%);
    color: var(--color-white);
    padding-block: var(--space-7);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
  }

  .hero-eyebrow {
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* Phase 7 (Master Completion Workflow, 2026-07-29): a real WCAG
       contrast gap, not the shared --color-gold-500 token - verified by
       sampling the actual rendered pixel color behind this text
       (~rgb(22,48,36), close to forest-900) at 4.58:1, just barely over
       AA's 4.5:1 floor for this text's size/weight - and the hero's
       160deg gradient runs toward the lighter forest-700 at its far
       edge, where gold-500 drops to 3.25:1 (fails). This lightened value
       passes AA (4.5:1+) against both gradient stops with real margin,
       scoped to this component only - --color-gold-500 itself stays
       unchanged for every other (already-passing) use of it. */
    color: #d4ad74;
    margin-block-end: var(--space-3);
  }

  .hero h1 {
    font-family: var(--font-family-display);
    font-size: var(--font-size-hero);
    line-height: 1.05;
    margin-block: 0 var(--space-4);
    /* Premium Visual Redesign: a soft depth shadow on the headline
       itself - reinforces the "dimensional" direction without any
       layout/motion cost. Subtle enough not to reduce legibility. */
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  .hero-subhead {
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.88);
    max-width: 34rem;
    margin-block-end: var(--space-5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }

  .hero-secondary-link {
    margin-block: 0 var(--space-5);
  }

  /* Phase 5 (Master Completion Workflow, 2026-07-29): dimmed from solid
     white/font-weight 600 - at full white it read as a near-equal 3rd
     CTA competing with the two buttons above it. Matches the trust
     indicators' opacity below it instead, so the visual hierarchy is
     unambiguous: primary button > secondary button > this tertiary
     link > trust indicators. */
  .hero-secondary-link a {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero-secondary-link a:hover {
    color: var(--color-white);
  }

  .hero-trust-indicators {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-trust-indicators li {
    padding-inline-start: var(--space-4);
    position: relative;
  }

  .hero-trust-indicators li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-gold-500);
  }

  /* Premium Visual Redesign: the hero image and its floating proof card
     both live inside .hero-visual so the proof card can be positioned
     relative to the whole visual column, overlapping the image's edge
     rather than being clipped by .hero-media's own overflow:hidden. */
  .hero-visual {
    position: relative;
  }

  .hero-media {
    position: relative;
    /* A real, intentional media aspect ratio (4/3) instead of an
       arbitrary min-height blob - Phase 2 "hero media readiness"
       requirement. Still sized against the column's own width, not the
       hero's overall height, so it scales naturally with the grid. */
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-elevation-3);
    /* Desktop-only dimensional tilt - see the @media (min-width: 900px)
       block below, which is where the tilt transform is actually
       applied. Kept untransformed by default so mobile/tablet (and any
       reduced-motion context) render a plain, still-premium-via-shadow
       flat frame. */
    transition: transform var(--motion-duration-slow) ease;
  }

  /* One source photo (roof-wash-hero-after, ~3:2 landscape) at every
     breakpoint - only object-position changes responsively to keep the
     roof ridge/tile detail centered as the crop narrows from the wide
     desktop panel down to the taller mobile one. Scoped to this
     component's own image only (:global reaches into ResponsiveImage's
     rendered <img>) - does not affect any other fill-mode image
     elsewhere on the page. */
  .hero-media :global(img) {
    object-position: center center;
  }

  @media (max-width: 640px) {
    .hero-media :global(img) {
      object-position: 60% center;
    }
  }

  .hero-media-badge {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
    background-color: rgba(20, 42, 32, 0.75);
    border-radius: var(--radius-full);
  }

  /* Floating proof card - hidden by default (mobile/tablet); shown only
     at >=900px, where there's genuine room for it to read as a
     considered layered element rather than a cramped afterthought. */
  .hero-proof-card {
    display: none;
  }

  @media (min-width: 900px) {
    .hero-media {
      transform: var(--depth-tilt-primary);
    }

    .hero-proof-card {
      display: block;
      position: absolute;
      left: -1.5rem;
      bottom: -1.75rem;
      width: 11rem;
      padding: var(--space-3);
      background-color: var(--color-white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-elevation-2);
      transform: var(--depth-tilt-secondary);
      transition: transform var(--motion-duration-base) ease;
    }

    .hero-proof-card:hover {
      transform: var(--depth-tilt-secondary) var(--depth-lift-hover-sm);
    }
  }

  .hero-proof-card-label {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-forest-700);
  }

  .hero-proof-card-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-1);
  }

  .hero-proof-thumb {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .hero-proof-thumb-tag {
    position: absolute;
    left: 2px;
    bottom: 2px;
    padding: 1px var(--space-1);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-white);
    background-color: rgba(20, 42, 32, 0.75);
    border-radius: var(--radius-sm);
  }

  .hero-proof-card-caption {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-xs);
    color: var(--color-charcoal-600);
  }

  /* ~48% of the desktop hero is visual (hero-media column plus its
     share of the gap), per the phase's 45-55% requirement. */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      order: -1;
    }

    .hero-media {
      aspect-ratio: 3/2;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-6) var(--space-5);
    }

    .hero-actions .btn {
      width: 100%;
    }
  }

  /* Design-system rule: any perspective/tilt transform must have a
     reduced-motion fallback that removes the tilt entirely, not just
     the transition - a static tilt is a compositional choice most
     users are fine with, but this respects the stricter reading of the
     redesign brief's accessibility requirement. Must come after the
     (min-width: 900px) block above so its higher specificity via
     source order actually wins for users who both qualify for the
     desktop tilt and have reduced motion enabled. */
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .hero-media {
      transform: none;
    }

    .hero-proof-card {
      transform: none;
    }

    .hero-proof-card:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media,
    .hero-proof-card {
      transition: none;
    }
  }
</style>
