---
// Master Completion Workflow, Phase 5 (2026-07-29): removed the 3
// placeholder ReviewCards. They were correctly, visibly labeled
// "Development placeholder - not a real review" - fully honest - but a
// "Customer Reviews" section built from 3 fake-named, five-star cards
// still reads as an unfinished section to a real visitor, working
// against the premium/trustworthy goal even though nothing was
// fabricated. ReviewSummary.astro (below) is the section's only content
// now - a single, intentional, honestly-worded panel - rather than a
// disclaimer buried under fake-looking cards. ReviewCard.astro is kept
// (not deleted) for when real, owner-verified reviews exist - it
// already supports a non-placeholder mode with a verifiedLink.
import ReviewSummary from './ReviewSummary.astro';
---

<section class="testimonials" aria-labelledby="testimonials-heading" id="reviews">
  <div class="container-wide">
    <h2 id="testimonials-heading" class="section-heading">Customer Reviews</h2>
    <ReviewSummary />
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--space-7);
  }
</style>
