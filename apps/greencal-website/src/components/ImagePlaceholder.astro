---
// Honest stand-in for real photography that does not exist yet in this
// repository. Deliberately renders as an abstract icon/gradient panel,
// never a fabricated or hotlinked photo, and never claims to depict a
// real GreenCal job. `label` is used only for the accessible name and a
// code-level record of what real photo is needed here - see the
// redesign report's "missing photography" list, not shown as loud
// on-page placeholder text.
export interface Props {
  label: string;
  ratio?: '16/9' | '4/3' | '1/1' | '3/2';
  icon?: 'roof' | 'wall' | 'concrete' | 'building' | 'community' | 'camera';
  /** Absolutely fills its positioned parent instead of sizing via `ratio` - for hero/full-bleed media slots. */
  fill?: boolean;
  /** 'dark' reads correctly under a dark overlay (e.g. the hero); 'light' is the default card/section treatment. */
  tone?: 'light' | 'dark';
  /**
   * Visible on-panel caption (e.g. "Roof Cleaning") shown alongside a
   * "Photo Coming Soon" note - Phase 2 visual-cleanup requirement: the
   * placeholder must read as an intentional, labeled media slot, not a
   * generic empty icon. When omitted, only the icon renders (used for
   * very small slots where a caption wouldn't fit).
   */
  categoryLabel?: string;
  /** Overrides the default "Photo Coming Soon" status text - e.g. "Commercial Project Media Coming Soon" so a commercial/HOA slot is never confused with the real residential photos used elsewhere on the page. */
  statusLabel?: string;
}

const {
  label,
  ratio = '4/3',
  icon = 'camera',
  fill = false,
  tone = 'light',
  categoryLabel,
  statusLabel = 'Photo Coming Soon',
} = Astro.props;

const icons: Record<string, string> = {
  roof: 'M4 12L12 5l8 7M6 12v7h12v-7',
  wall: 'M4 4h16v16H4zM4 10h16M10 4v16',
  concrete: 'M4 8h16M4 12h16M4 16h16',
  building: 'M6 3h12v18H6zM9 7h2m2 0h2M9 11h2m2 0h2M9 15h2m2 0h2',
  community: 'M4 20v-6a4 4 0 014-4h0a4 4 0 014 4v6M12 20v-8a4 4 0 014-4h0a4 4 0 014 4v8',
  camera: 'M4 8h3l2-2h6l2 2h3v11H4zM12 17a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
};
---

<div
  class={`image-placeholder image-placeholder-${tone} ${fill ? 'image-placeholder-fill' : ''}`}
  style={fill ? undefined : `aspect-ratio: ${ratio};`}
  role="img"
  aria-label={label}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
    <path d={icons[icon]} stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {
    categoryLabel && (
      <p class="image-placeholder-caption">
        <span class="image-placeholder-category">{categoryLabel}</span>
        <span class="image-placeholder-status">{statusLabel}</span>
      </p>
    )
  }
</div>

<style>
  .image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    text-align: center;
    padding: var(--space-3);
  }

  .image-placeholder-light {
    background: linear-gradient(
      160deg,
      var(--color-cream-100) 0%,
      var(--color-cream-50) 55%,
      var(--color-white) 100%
    );
    border: 1px solid var(--color-gold-500);
    color: var(--color-gold-700);
  }

  .image-placeholder-dark {
    background: linear-gradient(160deg, var(--color-forest-500) 0%, var(--color-forest-900) 100%);
    border: 1px solid rgba(176, 141, 87, 0.6);
    color: rgba(255, 255, 255, 0.5);
  }

  .image-placeholder-fill {
    position: absolute;
    inset: 0;
    height: 100%;
    border-radius: 0;
  }

  .image-placeholder svg {
    width: 16%;
    max-width: 2.25rem;
    height: auto;
    opacity: 0.45;
    flex: none;
  }

  .image-placeholder-caption {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .image-placeholder-category {
    font-weight: 700;
    font-size: var(--font-size-base);
  }

  .image-placeholder-status {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.8;
  }

  .image-placeholder-fill .image-placeholder-caption {
    max-width: 80%;
  }
</style>
