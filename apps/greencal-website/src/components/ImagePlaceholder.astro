---
// Honest stand-in for real photography that does not exist yet in this
// repository. Deliberately renders as an abstract icon/gradient panel,
// never a fabricated or hotlinked photo, and never claims to depict a
// real GreenCal job. `label` is used only for the accessible name and a
// code-level record of what real photo is needed here - see the
// redesign report's "missing photography" list, not shown as loud
// on-page placeholder text.
export interface Props {
  label: string;
  ratio?: '16/9' | '4/3' | '1/1' | '3/2';
  icon?: 'roof' | 'wall' | 'concrete' | 'building' | 'community' | 'camera';
}

const { label, ratio = '4/3', icon = 'camera' } = Astro.props;

const icons: Record<string, string> = {
  roof: 'M4 12L12 5l8 7M6 12v7h12v-7',
  wall: 'M4 4h16v16H4zM4 10h16M10 4v16',
  concrete: 'M4 8h16M4 12h16M4 16h16',
  building: 'M6 3h12v18H6zM9 7h2m2 0h2M9 11h2m2 0h2M9 15h2m2 0h2',
  community: 'M4 20v-6a4 4 0 014-4h0a4 4 0 014 4v6M12 20v-8a4 4 0 014-4h0a4 4 0 014 4v8',
  camera: 'M4 8h3l2-2h6l2 2h3v11H4zM12 17a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
};
---

<div class="image-placeholder" style={`aspect-ratio: ${ratio};`} role="img" aria-label={label}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
    <path d={icons[icon]} stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</div>

<style>
  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: linear-gradient(
      160deg,
      var(--color-cream-100) 0%,
      var(--color-cream-50) 55%,
      var(--color-white) 100%
    );
    border: 1px solid var(--color-gold-500);
    border-radius: var(--radius-md);
    color: var(--color-gold-700);
    overflow: hidden;
  }

  .image-placeholder svg {
    width: 22%;
    max-width: 3.5rem;
    height: auto;
    opacity: 0.55;
  }
</style>
