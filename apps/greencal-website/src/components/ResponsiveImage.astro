---
// Single seam between "no real photo exists" and "a real MediaRecord
// exists." Every component that needs a photo slot renders through
// this component, not ImagePlaceholder directly, so swapping media in
// is a one-prop change, not a markup change. Images here live under
// public/ (not src/), so astro:assets' <Image> component (which only
// processes build-time-imported src/ assets) does not apply - explicit
// width/height/sizes are set by hand instead, from MediaRecord's own
// real pixel dimensions, which is equally correct for CLS prevention.
// The rendered <img> needs an explicit CSS `width: 100%; height: auto;`
// alongside `aspect-ratio` (not aspect-ratio alone) - confirmed directly
// via computed-style inspection: the HTML width/height ATTRIBUTES (set
// for CLS prevention above) resolve to a definite, non-auto CSS height
// via presentational hints, and `aspect-ratio` only fills in a
// dimension that is actually `auto` - with both width (capped by the
// sitewide `img { max-width: 100% }` rule) and height (from the
// attribute) already definite, `aspect-ratio` was silently ignored and
// every card rendered at its own photo's native aspect ratio instead of
// the requested one.
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { MediaRecord } from '../types/content';

export interface Props {
  media?: MediaRecord;
  fallbackLabel: string;
  ratio?: '16/9' | '4/3' | '1/1' | '3/2';
  icon?: 'roof' | 'wall' | 'concrete' | 'building' | 'community' | 'camera';
  fill?: boolean;
  tone?: 'light' | 'dark';
  loading?: 'lazy' | 'eager';
  /** Visible "what goes here" caption on the placeholder - see ImagePlaceholder.astro. */
  categoryLabel?: string;
  /** Overrides the placeholder's default "Photo Coming Soon" status text. */
  statusLabel?: string;
  /** Responsive `sizes` hint for the real <img>. Only meaningful once multiple source widths exist; documented as a real limitation until then - see docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md. */
  sizes?: string;
}

const {
  media,
  fallbackLabel,
  ratio = '4/3',
  icon = 'camera',
  fill = false,
  tone = 'light',
  loading = 'lazy',
  categoryLabel,
  statusLabel,
  sizes = '100vw',
} = Astro.props;
---

{
  media && media.approvalStatus === 'approved' ? (
    <img
      src={media.fullSrc}
      alt={media.altText}
      width={media.width}
      height={media.height}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      decoding="async"
      class={fill ? 'responsive-image-fill' : undefined}
      style={
        fill
          ? undefined
          : `width: 100%; height: auto; aspect-ratio: ${ratio}; object-fit: cover;`
      }
    />
  ) : (
    <ImagePlaceholder
      label={fallbackLabel}
      ratio={ratio}
      icon={icon}
      fill={fill}
      tone={tone}
      categoryLabel={categoryLabel}
      statusLabel={statusLabel}
    />
  )
}

<style>
  .responsive-image-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
