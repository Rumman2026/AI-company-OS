---
// Four-column expansion (visual-refinement phase). "Privacy Policy,"
// "Terms," and "Accessibility" pages don't exist yet - omitted rather
// than linked to nowhere (see
// docs/GREENCAL_OWNER_VERIFICATION_REQUIRED.md). Business hours,
// Google Business Profile, Facebook, and Instagram are shown as
// explicit "not yet connected" notes, never as live-looking dead
// links. The pre-existing, tested <nav aria-label="Footer"> below is
// unchanged.
import { footerNav } from '../data/navigation';
import { servicesByCategory } from '../data/services';
import { siteInfo } from '../data/site';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
const residentialServices = servicesByCategory('residential');
const commercialHoaLinks = [
  ...servicesByCategory('commercial').slice(0, 3),
  ...servicesByCategory('multi-family-hoa'),
];
---

<footer class="site-footer">
  <div class="site-footer-top">
    <div class="site-footer-brand">
      <Wordmark variant="inverse" />
      <p class="site-footer-tagline">
        Residential, commercial, and multi-family exterior cleaning across approved Southern
        California communities.
      </p>
    </div>
  </div>

  <div class="site-footer-columns">
    <div class="site-footer-column">
      <h3>Company</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/#reviews">Reviews</a></li>
        <li><a href="/service-areas">Service Areas</a></li>
        <li><a href="/contact-us">Contact</a></li>
      </ul>
    </div>
    <div class="site-footer-column">
      <h3>Residential Services</h3>
      <ul>
        {residentialServices.map((service) => <li><a href={service.route}>{service.title}</a></li>)}
      </ul>
    </div>
    <div class="site-footer-column">
      <h3>Commercial &amp; HOA</h3>
      <ul>
        {commercialHoaLinks.map((service) => <li><a href={service.route}>{service.title}</a></li>)}
      </ul>
    </div>
    <div class="site-footer-column">
      <h3>Contact</h3>
      <ul class="site-footer-contact-list">
        <li>{siteInfo.businessName}</li>
        <li><a href={siteInfo.phoneHref}>{siteInfo.phoneDisplay}</a></li>
        <li><a href={siteInfo.emailHref}>{siteInfo.emailDisplay}</a></li>
        <li class="site-footer-note">Business hours: not yet published</li>
        <li class="site-footer-note">Google Business Profile: not yet connected</li>
        <li class="site-footer-note">Facebook / Instagram: not yet connected</li>
      </ul>
    </div>
  </div>

  <nav aria-label="Footer" class="site-footer-nav">
    <ul>
      {
        footerNav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <hr class="divider" />
  <p>&copy; {year} GreenCal Pressure Washing</p>
  <details class="tracking-preferences">
    <summary>Tracking preferences</summary>
    <div class="tracking-preferences-panel">
      <p id="tracking-preferences-status">Checking tracking status…</p>
      <label>
        <input type="checkbox" id="tracking-consent-toggle" />
        Allow optional analytics tracking
      </label>
      <p class="field-help">
        Declining does not affect your ability to browse, call, email, or request a quote. You
        can change this choice at any time.
      </p>
    </div>
  </details>
</footer>

<style>
  .site-footer {
    background-color: var(--color-forest-900);
    color: rgba(255, 255, 255, 0.85);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .site-footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block-start: var(--space-5);
  }

  .site-footer-tagline {
    max-width: 28rem;
    margin-block-start: var(--space-3);
    color: rgba(255, 255, 255, 0.75);
  }

  .site-footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-5);
    margin-block: var(--space-6);
  }

  .site-footer-column h3 {
    font-size: var(--font-size-base);
    color: var(--color-gold-500);
    margin-block: 0 var(--space-3);
  }

  .site-footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer-column a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .site-footer-column a:hover {
    text-decoration: underline;
  }

  .site-footer-contact-list li:first-child {
    font-weight: 700;
    color: var(--color-white);
  }

  .site-footer-note {
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.55);
    font-style: italic;
  }

  .site-footer-nav {
    margin-block-start: var(--space-5);
  }

  .site-footer-nav a {
    color: rgba(255, 255, 255, 0.85);
  }

  .site-footer .divider {
    border-top-color: rgba(255, 255, 255, 0.25);
  }

  .site-footer .tracking-preferences-panel {
    border-color: rgba(255, 255, 255, 0.25);
    color: var(--color-charcoal-900);
    background-color: var(--color-white);
  }
</style>

<script>
  import { getConsentState, setConsentState } from '../lib/tracking/consent';
  import { getTrackingConfig } from '../lib/tracking/config';

  const toggle = document.querySelector<HTMLInputElement>('#tracking-consent-toggle');
  const status = document.querySelector<HTMLParagraphElement>('#tracking-preferences-status');

  if (toggle && status) {
    const renderStatus = (): void => {
      const { gtmContainerId } = getTrackingConfig();
      if (!gtmContainerId) {
        status.textContent = 'No optional tracking is currently active on this site.';
        return;
      }
      status.textContent = getConsentState().analyticsGranted
        ? 'Optional analytics tracking is currently enabled.'
        : 'Optional analytics tracking is currently disabled.';
    };

    toggle.checked = getConsentState().analyticsGranted;
    renderStatus();

    toggle.addEventListener('change', () => {
      setConsentState({ analyticsGranted: toggle.checked });
      renderStatus();
    });
  }
</script>
