---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileConversionBar from '../components/MobileConversionBar.astro';
import '../styles/tokens.css';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;

// Domain confirmed and authorized - see DECISIONS.md ADR-0005. Astro.site
// is the single source of truth, set in astro.config.mjs.
const canonicalUrl = new URL(path, Astro.site).toString();

// Master Completion Workflow, Phase 6 (2026-07-29): og:image/twitter:image
// were previously omitted sitewide because no approved brand image asset
// existed. The Logo Integration and Real Photo Integration passes
// changed that - this uses the same real, owner-supplied, already-
// approved roof-washing hero photo the homepage hero itself uses (see
// src/data/media.ts's 'roof-wash-hero-after' MediaRecord), not a new or
// fabricated asset. One sitewide image rather than a per-page image:
// no other page has its own distinct approved photo yet.
const ogImageUrl = new URL(
  '/assets/greencal/generated/homepage/roof-wash-hero-after.webp',
  Astro.site,
).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1264" />
    <meta property="og:image:height" content="848" />
    <meta property="og:image:alt" content="Aerial view of a concrete tile roof after GreenCal's roof-washing service" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- twitter:site/twitter:creator are omitted: no verified GreenCal Twitter/X account exists. -->
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileConversionBar />
    <script>
      import { bindEngagementTracking } from '../lib/tracking/bind';
      bindEngagementTracking();
    </script>
  </body>
</html>
