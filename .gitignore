# Node
node_modules/
.env
.env.local
.env.*.local
.env.cloud
.DS_Store

# Credentials / secrets / runtime logs — never commit real values
# (see CLAUDE.md "Security and Git boundaries" and
# docs/cloud/GLM_SANDBOX_PILOT.md "Credential checkpoint")
*.pem
*.key
*.log
logs/

# Build output
dist/
apps/*/build/
packages/*/build/
coverage/

# Astro
.astro/

# Vercel
.vercel/

# Playwright
test-results/
playwright-report/
blob-report/
.playwright-mcp/

# Generated health-check report (see .github/workflows/greencal-health-check.yml
# and apps/greencal-website/scripts/health-check.mjs) - regenerated on
# every run, uploaded as a CI artifact, never committed.
apps/greencal-website/health-check-report.json

# IDE
.vscode/
.idea/

# Docker
docker-compose.override.yml

# Design source/editing files (never committed - see CLAUDE.md
# documentation behavior and the GreenCal websites rule: only web-ready
# exports (PNG/SVG/WebP/JPG) belong in public/assets - not the raw
# Illustrator/Photoshop/PDF sources they were exported from).
apps/greencal-website/public/assets/**/*.ai
apps/greencal-website/public/assets/**/*.psd
apps/greencal-website/public/assets/**/*.pdf
apps/greencal-website/public/assets/**/*.eps
